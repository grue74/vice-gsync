# ViceAutomake.cmake - read source lists straight out of VICE's Makefile.am files
#
# The autotools build remains the canonical build of VICE. To avoid keeping a
# second, hand-maintained list of ~1000 source files in sync, the MSVC build
# parses the relevant Makefile.am files at configure time.
#
# Supported subset of automake syntax (enough for VICE's library Makefiles):
#   - backslash line continuations and '#' comments
#   - NAME = value / NAME += value
#   - if COND / if !COND / else / endif, evaluated against VICE_AM_CONDITIONS
#   - $(NAME) expansion of variables defined in the same file
#   - @SUBST@ tokens are dropped (configure substitutions); callers add the
#     equivalent files explicitly
#
# Usage:
#   vice_am_get(<out-var> <dir relative to src> <automake variable>)
#   vice_am_library(<target> <dir relative to src> <libname without lib/.a>)

# Conditions that are "true" for this build. Everything else is false.
if(NOT DEFINED VICE_AM_CONDITIONS)
    set(VICE_AM_CONDITIONS "")
endif()

# Parse one Makefile.am into a set of global properties (cached per file).
function(_vice_am_parse dir)
    string(MAKE_C_IDENTIFIER "${dir}" key)
    get_property(done GLOBAL PROPERTY VICE_AM_${key}__PARSED)
    if(done)
        return()
    endif()

    set(file "${VICE_SRC_DIR}/${dir}/Makefile.am")
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "ViceAutomake: ${file} does not exist")
    endif()
    file(READ "${file}" content)
    # join continuation lines
    string(REGEX REPLACE "\\\\[ \t]*\r?\n" " " content "${content}")
    string(REPLACE "\r" "" content "${content}")
    # protect list separators before splitting into lines
    string(REPLACE ";" " " content "${content}")
    string(REPLACE "\n" ";" lines "${content}")

    set(active_stack "TRUE")
    set(active TRUE)
    set(vars "")
    foreach(line IN LISTS lines)
        # strip comments
        string(REGEX REPLACE "#.*$" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        endif()

        if(line MATCHES "^if[ \t]+(!?)([A-Za-z0-9_]+)$")
            set(neg "${CMAKE_MATCH_1}")
            set(cond "${CMAKE_MATCH_2}")
            list(FIND VICE_AM_CONDITIONS "${cond}" idx)
            if(idx GREATER -1)
                set(val TRUE)
            else()
                set(val FALSE)
            endif()
            if(neg STREQUAL "!")
                if(val)
                    set(val FALSE)
                else()
                    set(val TRUE)
                endif()
            endif()
            # push: remember the parent state and this condition's value
            list(APPEND active_stack "${active}|${val}")
            if(active AND val)
                set(active TRUE)
            else()
                set(active FALSE)
            endif()
            continue()
        elseif(line MATCHES "^else([ 	].*)?$")
            list(GET active_stack -1 top)
            string(REPLACE "|" ";" top "${top}")
            list(GET top 0 parent)
            list(GET top 1 val)
            if(parent AND NOT val)
                set(active TRUE)
            else()
                set(active FALSE)
            endif()
            continue()
        elseif(line MATCHES "^endif([ 	].*)?$")
            list(GET active_stack -1 top)
            list(REMOVE_AT active_stack -1)
            string(REPLACE "|" ";" top "${top}")
            list(GET top 0 active)
            continue()
        endif()

        if(NOT active)
            continue()
        endif()

        if(line MATCHES "^([A-Za-z0-9_]+)[ \t]*(\\+?=)(.*)$")
            set(name "${CMAKE_MATCH_1}")
            set(op "${CMAKE_MATCH_2}")
            string(STRIP "${CMAKE_MATCH_3}" value)
            string(REGEX REPLACE "[ \t]+" ";" value "${value}")
            if(op STREQUAL "+=")
                get_property(old GLOBAL PROPERTY VICE_AM_${key}_${name})
                list(APPEND old ${value})
                set(value "${old}")
            endif()
            set_property(GLOBAL PROPERTY VICE_AM_${key}_${name} "${value}")
        endif()
    endforeach()
    set_property(GLOBAL PROPERTY VICE_AM_${key}__PARSED TRUE)
endfunction()

# Recursively expand $(VAR) references against the same Makefile.am
function(_vice_am_expand out key tokens depth)
    if(depth GREATER 10)
        message(FATAL_ERROR "ViceAutomake: recursion too deep expanding ${tokens}")
    endif()
    set(result "")
    foreach(tok IN LISTS tokens)
        if(tok MATCHES "^\\$[\\(\\{]([A-Za-z0-9_]+)[\\)\\}]$")
            get_property(sub GLOBAL PROPERTY VICE_AM_${key}_${CMAKE_MATCH_1})
            math(EXPR d "${depth} + 1")
            _vice_am_expand(sub_exp "${key}" "${sub}" ${d})
            list(APPEND result ${sub_exp})
        elseif(tok MATCHES "^@.*@$")
            # configure substitution; ignored
        else()
            list(APPEND result "${tok}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# vice_am_get(<out> <dir> <variable>): raw (expanded) token list
function(vice_am_get out dir var)
    _vice_am_parse("${dir}")
    string(MAKE_C_IDENTIFIER "${dir}" key)
    get_property(tokens GLOBAL PROPERTY VICE_AM_${key}_${var})
    _vice_am_expand(expanded "${key}" "${tokens}" 0)
    set(${out} "${expanded}" PARENT_SCOPE)
endfunction()

# vice_am_sources(<out> <dir> <libname>): compilable sources of lib<libname>.a,
# including objects pulled in through lib<libname>_a_LIBADD (foo.o -> foo.c/.cc)
function(vice_am_sources out dir libname)
    string(MAKE_C_IDENTIFIER "lib${libname}_a" amname)
    vice_am_get(srcs "${dir}" "${amname}_SOURCES")
    vice_am_get(adds "${dir}" "${amname}_LIBADD")
    set(result "")
    foreach(s IN LISTS srcs)
        if(s MATCHES "\\.(c|cc|cpp)$")
            list(APPEND result "${VICE_SRC_DIR}/${dir}/${s}")
        endif()
    endforeach()
    foreach(o IN LISTS adds)
        if(o MATCHES "^(.*)\\.o$")
            foreach(ext c cc cpp)
                if(EXISTS "${VICE_SRC_DIR}/${dir}/${CMAKE_MATCH_1}.${ext}")
                    list(APPEND result "${VICE_SRC_DIR}/${dir}/${CMAKE_MATCH_1}.${ext}")
                    break()
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES result)
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# vice_am_library(<target> <dir> <libname> [EXTRA files...])
function(vice_am_library target dir libname)
    cmake_parse_arguments(ARG "" "" "EXTRA;EXCLUDE" ${ARGN})
    vice_am_sources(srcs "${dir}" "${libname}")
    foreach(e IN LISTS ARG_EXTRA)
        list(APPEND srcs "${VICE_SRC_DIR}/${dir}/${e}")
    endforeach()
    foreach(e IN LISTS ARG_EXCLUDE)
        list(REMOVE_ITEM srcs "${VICE_SRC_DIR}/${dir}/${e}")
    endforeach()
    if(NOT srcs)
        message(FATAL_ERROR "ViceAutomake: no sources found for lib${libname}.a in ${dir}")
    endif()
    add_library(${target} STATIC ${srcs})
    target_link_libraries(${target} PRIVATE vice_options)
    set_target_properties(${target} PROPERTIES FOLDER "libs")
endfunction()
